{
  "name": "agentdeck",
  "version": "0.13.0",
  "description": "本地任务看板 — 把任务派给本地 agent 执行",
  "main": "./out/main/index.js",
  "author": "agentdeck",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pack": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder",
    "smoke": "node scripts/smoke-runner.mjs",
    "smoke:event-log": "node scripts/smoke-event-log.mjs",
    "smoke:permission": "node scripts/smoke-permission.mjs",
    "smoke:execution-services": "node scripts/smoke-execution-services.mjs",
    "smoke:ipc-validation": "node scripts/smoke-ipc-validation.mjs",
    "smoke:zcode": "node scripts/smoke-zcode.mjs",
    "smoke:final-dedup": "node scripts/smoke-final-dedup.mjs",
    "smoke:clis": "node scripts/smoke-cli-adapters.mjs",
    "smoke:cli-adapters": "node scripts/smoke-cli-adapters.mjs",
    "smoke:cli-errors": "node scripts/smoke-cli-errors.mjs",
    "smoke:git-errors": "node scripts/smoke-git-errors.mjs",
    "smoke:delegate": "node scripts/smoke-delegate.mjs",
    "e2e:delegate": "node scripts/e2e-delegate-real.mjs",
    "smoke:migration": "node scripts/smoke-migration.mjs",
    "smoke:failure": "node scripts/smoke-failure.mjs",
    "smoke:diff": "node scripts/smoke-diff.mjs",
    "smoke:retry": "node scripts/smoke-retry.mjs",
    "smoke:flow": "node scripts/smoke-flow.mjs",
    "smoke:resume": "node scripts/smoke-resume.mjs",
    "smoke:issues": "node scripts/smoke-issues.mjs",
    "smoke:automation": "node scripts/smoke-automation.mjs",
    "smoke:runtime-analytics": "node scripts/smoke-runtime-analytics.mjs",
    "smoke:taskflow": "node scripts/smoke-taskflow.mjs",
    "smoke:model": "node scripts/smoke-model.mjs",
    "smoke:continue": "node scripts/smoke-continue.mjs",
    "smoke:round": "node scripts/smoke-round.mjs",
    "smoke:turn-model": "node scripts/smoke-turn-model.mjs",
    "smoke:stage6": "npm run typecheck && npm run smoke:taskflow && npm run smoke:turn-model && npm run smoke:migration && npm run smoke:issues",
    "smoke:goal": "node scripts/smoke-goal.mjs",
    "smoke:stage7": "npm run typecheck && npm run smoke:stage6 && npm run smoke && npm run smoke:goal",
    "smoke:all": "npm run smoke && npm run smoke:event-log && npm run smoke:permission && npm run smoke:execution-services && npm run smoke:ipc-validation && npm run smoke:final-dedup && npm run smoke:cli-errors && npm run smoke:git-errors && npm run smoke:delegate && npm run smoke:migration && npm run smoke:failure && npm run smoke:diff && npm run smoke:retry && npm run smoke:flow && npm run smoke:resume && npm run smoke:issues && npm run smoke:automation && npm run smoke:runtime-analytics && npm run smoke:taskflow && npm run smoke:model && npm run smoke:continue && npm run smoke:round && npm run smoke:turn-model && npm run smoke:goal"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "lucide-react": "^1.37.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  }
}
